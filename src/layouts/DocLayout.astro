---
import '../styles/global.css';
interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — AI Agent Repo Guide</title>
</head>
<body>
  <header class="topnav">
    <a href={base} class="brand">AI Agent Repo Guide</a>
    <nav class="nav-links">
      <a href={`${base}terminology`}>Terminology</a>
      <a href={`${base}claude-reference`}>Claude Code</a>
      <a href={`${base}codex-reference`}>Codex</a>
      <a href={`${base}ibmbob-reference`}>IBM Bob</a>
      <a href="https://github.com/RafflesiaKhan/prepare-repo-for-ai-agent" target="_blank" rel="noopener">GitHub ↗</a>
    </nav>
  </header>
  <div class="doc-layout">
    <aside class="sidebar">
      <p class="sidebar-heading">Documents</p>
      <nav>
        <a href={`${base}terminology`}>Terminology Map</a>
        <a href={`${base}claude-reference`}>Claude Code Reference</a>
        <a href={`${base}codex-reference`}>Codex Reference</a>
        <a href={`${base}ibmbob-reference`}>IBM Bob Reference</a>
      </nav>
    </aside>
    <main class="prose">
      <slot />
    </main>
  </div>
  <footer>
    <p>A public knowledge base for AI agent–ready repositories. <a href="https://github.com/RafflesiaKhan/prepare-repo-for-ai-agent">Contribute on GitHub</a>.</p>
  </footer>
</body>
</html>
